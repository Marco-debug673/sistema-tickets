<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Solicitud de Servicio</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
    .btn-anim:hover {
      transform: scale(1.03);
      transition: transform 0.3s ease;
    }
     </style>
</head>
<body class="bg-info">
    <div class="container-fluid py-4">
        <div class="row justify-content-center">
            <div class="col-12 col-md-11 col-lg-10 col-xl-9">
                <form id="solicitudForm" action="@Url.Action("GuardarSolicitud", "Solicitud")" method="post" enctype="multipart/form-data" class="bg-dark p-5 rounded shadow w-100">
                    <div class="d-flex align-items-center justify-content-center mb-4">
                        <input type="hidden" name="numero_serie" id="numero_serie_hidden">
                        <a href="@Url.Action("Logout", "Account")" class="btn btn-outline-danger btn-anim me-3" title="Cerrar Sesión / Volver">
                            <i class="bi bi-box-arrow-right fs-4"></i>
                        </a>
                        <h2 class="text-primary mb-0">Solicitud de Servicio</h2>
                    </div>
                    <div id="alertContainer">
                        @if (ViewBag.ErrorMessage != null)
                        {
                            <div class="alert alert-danger text-center">@ViewBag.ErrorMessage</div>
                        }
                    </div>
                    <div class="row g-2">
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input type="text" class="form-control" id="nombre_cliente" name="nombre_cliente" placeholder="Nombre Cliente" value="@ViewBag.Usuario" disabled>
                                <label for="marcaVehiculo">Cliente</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input type="text" class="form-control" id="nomenclatura" name="nomenclatura" placeholder="Nomenclatura" autocomplete="off">
                                <label for="modeloVehiculo">Nomenclatura</label>
                                <div id="nomenclaturaFeedback" class="small mt-1 d-none"></div>
                            </div>
                        </div>
                    </div>
                    <br>
                    <div class="row g-2">
                        <div class="col-md-6">
                            <div class="form-floating mb-3">
                                <textarea class="form-control" id="descripcion" name="descripcion" placeholder="Escriba la descripción" style="height: 100px"></textarea>
                                <label for="descripcionServicio">Descripción</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating mb-3">
                                <input type="file" class="form-control" id="fotoServicio" name="evidenciaFiles" accept="image/*,.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx" placeholder="Adjuntar Archivos" multiple>
                                <label for="fotoServicio">Adjuntar Imagen/Evidencia</label>
                            </div>
                        </div>
                    </div>
                    <br>
                    <div class="d-flex flex-column flex-sm-row justify-content-between gap-2 mb-3">
                        <button class="btn btn-warning btn-anim flex-fill" type="button" id="saveBtn" >Guardar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal para Número de Serie -->
    <div class="modal fade" id="serieModal" tabindex="-1" aria-labelledby="serieModalLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-dark text-white">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title text-primary" id="serieModalLabel">Agregar Número de Serie</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="confirmMessage">
                        <p>¿Desea agregar el número de serie del equipo?</p>
                    </div>
                    <div id="serieInputContainer" class="form-floating d-none">
                        <input type="text" class="form-control" id="numero_serie_input" placeholder="Número de Serie">
                        <label for="numero_serie_input">Número de Serie</label>
                        <div class="invalid-feedback">
                            Por favor, ingresa el número de serie.
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <div id="initialButtons">
                        <button type="button" class="btn btn-outline-secondary" id="noBtn">No</button>
                        <button type="button" class="btn btn-primary" id="siBtn">Sí</button>
                    </div>
                    <button type="button" class="btn btn-success d-none" id="finalSaveBtn">Guardar</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const nomenclaturaInput = document.getElementById('nomenclatura');
        const feedback = document.getElementById('nomenclaturaFeedback');
        let debounceTimer;

        // Validación en tiempo real mientras el usuario escribe
        nomenclaturaInput.addEventListener('input', function() {
            clearTimeout(debounceTimer);
            const nomenclatura = this.value.trim();

            if (nomenclatura === "") {
                this.classList.remove('is-valid', 'is-invalid');
                feedback.classList.add('d-none');
                return;
            }

            debounceTimer = setTimeout(async () => {
                try {
                    const response = await fetch(`@Url.Action("VerificarNomenclatura", "Historial")?nomenclatura=${encodeURIComponent(nomenclatura)}`);
                    const result = await response.json();

                    nomenclaturaInput.classList.remove('is-valid', 'is-invalid');
                    feedback.classList.remove('d-none', 'text-success', 'text-danger');

                    if (result.exists) {
                        nomenclaturaInput.classList.add('is-valid');
                        feedback.textContent = '✓ Nomenclatura válida';
                        feedback.classList.add('text-success');
                    } else {
                        nomenclaturaInput.classList.add('is-invalid');
                        feedback.textContent = '✗ Debe de escribir la nomenclatura completa';
                        feedback.classList.add('text-danger');
                    }
                } catch (error) {
                    console.error('Error al validar nomenclatura:', error);
                }
            }, 500); // Espera 500ms después de que el usuario deje de escribir
        });

        // Lógica del botón principal de Guardar
        document.getElementById('saveBtn').addEventListener('click', async function(e) {
            e.preventDefault(); // Prevenimos el envío del formulario
            
            const form = document.getElementById('solicitudForm');
            const nomenclatura = nomenclaturaInput.value.trim();
            const saveBtn = document.getElementById('saveBtn');
            
            clearTimeout(debounceTimer); // Limpiar cualquier validación en tiempo real pendiente

            if (!nomenclatura) {
                showAlert('Por favor, escriba la nomenclatura completa.');
                nomenclaturaInput.classList.add('is-invalid'); // Marcar como inválido si está vacío al enviar
                return;
            }

            // Deshabilitar botón mientras se valida para evitar múltiples clics
            saveBtn.disabled = true;
            const originalBtnText = saveBtn.innerText;
            saveBtn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Validando...';

            try {
                const response = await fetch(`@Url.Action("VerificarNomenclatura", "Historial")?nomenclatura=${encodeURIComponent(nomenclatura)}`);
                const result = await response.json();

                if (result.exists) {
                    // Si la nomenclatura existe exactamente, procedemos con el envío
                    const serieModal = new bootstrap.Modal(document.getElementById('serieModal'));
                    serieModal.show();
                    saveBtn.disabled = false; // Habilitamos el botón de nuevo
                    saveBtn.innerText = originalBtnText;
                } else {
                    showAlert('Debe de escribir la nomenclatura completa');
                    saveBtn.disabled = false;
                    saveBtn.innerText = originalBtnText;
                    nomenclaturaInput.classList.add('is-invalid'); // Marcar como inválido si no se encuentra al enviar
                    feedback.textContent = '✗ Debe de escribir la nomenclatura completa';
                    feedback.classList.remove('d-none');
                    feedback.classList.add('text-danger');
                }
            } catch (error) {
                console.error('Error al validar nomenclatura:', error);
                showAlert('Error de conexión al validar la nomenclatura.');
                saveBtn.disabled = false; // Re-habilitar botón en caso de error
                saveBtn.innerText = originalBtnText; // Restaurar texto del botón
                nomenclaturaInput.classList.add('is-invalid'); // Marcar como inválido en caso de error de conexión
                feedback.textContent = 'Error de conexión al validar la nomenclatura.';
                feedback.classList.remove('d-none');
                feedback.classList.add('text-danger');
            }
        });

        // Lógica del Modal de Número de Serie
        const serieModalEl = document.getElementById('serieModal');
        const confirmMessage = document.getElementById('confirmMessage');
        const serieInputContainer = document.getElementById('serieInputContainer');
        const initialButtons = document.getElementById('initialButtons');
        const finalSaveBtn = document.getElementById('finalSaveBtn');
        const form = document.getElementById('solicitudForm');

        // Botón "Sí"
        document.getElementById('siBtn').addEventListener('click', function() {
            confirmMessage.classList.add('d-none');
            initialButtons.classList.add('d-none');
            serieInputContainer.classList.remove('d-none');
            finalSaveBtn.classList.remove('d-none');
        });

        // Botón "No"
        document.getElementById('noBtn').addEventListener('click', function() {
            document.getElementById('numero_serie_hidden').value = ''; // Aseguramos que no se envíe nada
            const saveBtn = document.getElementById('saveBtn');
            const originalBtnText = 'Guardar'; // O el texto original que tenías
            saveBtn.disabled = false;
            saveBtn.innerText = originalBtnText;
            form.submit();
        });

        // Botón "Guardar Todo" (después de decir que sí)
        document.getElementById('finalSaveBtn').addEventListener('click', function() {
            const numeroSerieInput = document.getElementById('numero_serie_input');
            const numeroSerie = numeroSerieInput.value.trim();

            if (numeroSerie === '') {
                numeroSerieInput.classList.add('is-invalid');
            } else {
                numeroSerieInput.classList.remove('is-invalid');
                document.getElementById('numero_serie_hidden').value = numeroSerie;
                form.submit();
            }
        });

        // Resetear el modal cuando se cierra
        serieModalEl.addEventListener('hidden.bs.modal', function () {
            const numeroSerieInput = document.getElementById('numero_serie_input');
            confirmMessage.classList.remove('d-none');
            initialButtons.classList.remove('d-none');
            serieInputContainer.classList.add('d-none');
            finalSaveBtn.classList.add('d-none');
            numeroSerieInput.value = '';
            numeroSerieInput.classList.remove('is-invalid'); // Limpiar validación
        });

        function showAlert(message) {
            const container = document.getElementById('alertContainer');
            container.innerHTML = `
                <div class="alert alert-danger alert-dismissible fade show text-center" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>`;
        }
    </script>
</body>
</html>