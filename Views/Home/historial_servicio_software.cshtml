        let currentNomenclatura = 'todos';
        let currentPuesto = 'todos';
        let currentDepto = 'todos';

        function applyFilters() {
            const rows = document.querySelectorAll('#table-services tr');

            rows.forEach(row => {
                const rowTipo = row.dataset.tipo || '';
                const rowArea = row.dataset.area || '';
                const rowNombre = row.cells[2].textContent.trim().toLowerCase();
                const rowContacto = row.cells[3].textContent.trim().toLowerCase();
                const rowNomenclatura = row.cells[4].textContent.trim().toLowerCase();
                const rowEmpresa = row.cells[5].textContent.trim().toLowerCase();
                const rowSucursal = row.cells[6].textContent.trim().toLowerCase();
                const rowPuesto = row.cells[7].textContent.trim().toLowerCase();
                const rowDepto = row.cells[8].textContent.trim().toLowerCase();

                let matchTipo = false;
                if (currentTipo === 'todos') {
                    matchTipo = true;
                } else if (currentTipo.includes('-')) {
                    const [tipoPrincipal, areaEspecifica] = currentTipo.split('-');
                    matchTipo = (rowTipo === tipoPrincipal && rowArea === areaEspecifica);
                } else {
                    matchTipo = (rowTipo === currentTipo);
                }

                const matchSucursal = (currentSucursal === 'todos' || rowSucursal === currentSucursal.toLowerCase());
                const matchEmpresa = (currentEmpresa === 'todos' || rowEmpresa === currentEmpresa.toLowerCase());
                const matchNombre = (currentNombre === 'todos' || rowNombre === currentNombre.toLowerCase());
                const matchContacto = (currentContacto === 'todos' || rowContacto === currentContacto.toLowerCase());
                const matchNomenclatura = (currentNomenclatura === 'todos' || rowNomenclatura === currentNomenclatura.toLowerCase());
                const matchPuesto = (currentPuesto === 'todos' || rowPuesto === currentPuesto.toLowerCase());
                const matchDepto = (currentDepto === 'todos' || rowDepto === currentDepto.toLowerCase());

                row.style.display = (matchTipo && matchSucursal && matchEmpresa && matchNombre && matchContacto && matchNomenclatura && matchPuesto && matchDepto) ? "" : "none";
            });

            updateColumnVisibility(currentTipo);
        }

