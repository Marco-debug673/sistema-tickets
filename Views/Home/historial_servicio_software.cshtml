        document.getElementById('saveBtn').addEventListener('click', async function (event) {
            event.preventDefault();

            const updatedItems = [];
            const rows = document.querySelectorAll('#table-services tr');

            rows.forEach(row => {
                if (row.style.display === "none") return;

                const idOrden = row.dataset.idOrden;
                const origenTabla = row.dataset.origen;
                const estatusSelect = row.querySelector('select[name="estatus"]');
                const asignadoSelect = row.querySelector('select[name="asignado_a"]');
                const comentariosTextarea = row.querySelector('textarea[name="comentarios"]');

                if (idOrden && origenTabla && estatusSelect && asignadoSelect && comentariosTextarea) {
                    updatedItems.push({
                        IdOrden: parseInt(idOrden),
                        OrigenTabla: origenTabla,
                        Estatus: estatusSelect.value,
                        AsignadoA: asignadoSelect.value,
                        Comentarios: comentariosTextarea.value
                    });
                }
            });

            if (updatedItems.length === 0) {
                displayBootstrapAlert('No hay elementos visibles para guardar.', 'info');
                return;
            }

            try {
                const url = '@Url.Action("GuardarCambiosHistorialSoftware", "HistorialSoftware")';
                const response = await fetch(url, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(updatedItems)
                });

                if (!response.ok) {
                    const errorText = await response.text();
                    console.error('Error en la respuesta del servidor:', errorText);
                    throw new Error(`Error del servidor: ${response.status} ${response.statusText}`);
                }

                const result = await response.json();
                displayBootstrapAlert(result.message, result.success ? 'success' : 'danger');
            } catch (error) {
                displayBootstrapAlert('Error al conectar con el servidor: ' + error.message, 'danger');
            }
        });

