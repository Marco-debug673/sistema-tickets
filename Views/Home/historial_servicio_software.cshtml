@model IEnumerable<SistemaTickets.Models.HistorialSoftwareViewModel>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Historial de Solicitud de Servicio</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
    .btn-anim:hover {
      transform: scale(1.03);
      transition: transform 0.3s ease;
    }
    .img-clickable {
      cursor: zoom-in;
      transition: transform 0.2s ease-in-out, box-shadow 0.2s;
      border: 2px solid #fff;
      background-color: #f8f9fa;
    }
    .file-icon {
      font-size: 2rem;
      cursor: pointer;
      transition: transform 0.2s;
    }
    .file-icon:hover { transform: scale(1.2); }
    .img-clickable:hover {
      transform: scale(1.2);
      box-shadow: 0 4px 10px rgba(0,0,0,0.3);
      z-index: 10;
    }
    #fullImage, #fileViewer, #localDocViewer {
      height: 75vh;
      object-fit: contain;
      overflow: auto;
    }
    #localDocViewer {
      background-color: white;
      color: black;
      text-align: left;
      padding: 20px;
    }
    /* Estilos para submenús en cascada (dropend) */
    .dropdown-menu .dropend {
      position: relative;
    }
    .dropdown-menu .dropend .dropdown-menu {
      top: 0;
      left: 100%;
      margin-top: -5px;
      display: none;
    }
    .dropdown-menu .dropend:hover > .dropdown-menu {
      display: block;
    }
    .dropdown-item.dropdown-toggle::after {
      float: right;
      margin-top: 8px;
    }
     </style>
</head>
<body class="bg-info">
    <div class="container-fluid py-4">
        <!-- Botones de cabecera -->
        <div class="position-absolute top-0 end-0 p-3 d-flex gap-2">
            @if (ViewBag.Usuario == "gerencia001")
            {
                <a href="@Url.Action("historial_servicio", "Historial")" class="btn btn-dark shadow btn-anim" title="Ir a Hardware">
                    <i class="bi bi-pc-display fs-4"></i>
                </a>
            }
            <button class="btn btn-warning shadow btn-anim fw-bold d-flex align-items-center gap-2" type="submit" id="saveBtn">
                <i class="bi bi-check-circle-fill fs-4"></i> Guardar
            </button>
            <a href="@Url.Action("Index", "DashboardSoftware")" class="btn btn-primary shadow btn-anim" title="Panel">
                <i class="bi bi-grid-fill fs-4"></i>
            </a>
            <a href="@Url.Action("Logout", "Account")" class="btn btn-danger shadow btn-anim" title="Cerrar Sesión">
                <i class="bi bi-box-arrow-right fs-4"></i>
            </a>
        </div>

        <div class="row">
            <div class="col-12">
                <h2 class="text-dark fw-bold mb-4 text-center">Servicios de Software</h2>
                <div class="d-flex flex-wrap justify-content-center align-items-center mb-4 gap-2">
                    <div class="dropdown">
                        <button class="btn btn-dark dropdown-toggle shadow-sm btn-anim" type="button" id="filterStatusDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-funnel-fill me-1"></i> Filtrar por Solicitud de Servicio
                        </button>
                        <ul class="dropdown-menu shadow" aria-labelledby="filterStatusDropdown">
                            <li><a class="dropdown-item status-filter" href="#" data-status="todos">Ver Todos</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item status-filter" href="#" data-status="altas">Altas</a></li>
                            <li><a class="dropdown-item status-filter" href="#" data-status="bajas">Bajas</a></li>
                            <li><a class="dropdown-item status-filter" href="#" data-status="interfaces">Interfaces</a></li>
                            <li class="dropend">
                                <a class="dropdown-item dropdown-toggle" href="#">Business Pro</a>
                                <ul class="dropdown-menu shadow">
                                    <li><a class="dropdown-item status-filter" href="#" data-status="business pro">Ver Todos</a></li>
                                    <li><a class="dropdown-item status-filter" href="#" data-status="business pro-ventas">Ventas</a></li>
                                    <li><a class="dropdown-item status-filter" href="#" data-status="business pro-servicio">Servicio</a></li>
                                    <li><a class="dropdown-item status-filter" href="#" data-status="business pro-refacciones">Refacciones</a></li>
                                </ul>
                            </li>
                            <li class="dropend">
                                <a class="dropdown-item dropdown-toggle" href="#">Incadea</a>
                                <ul class="dropdown-menu shadow">
                                    <li><a class="dropdown-item status-filter" href="#" data-status="incadea">Ver Todos</a></li>
                                    <li><a class="dropdown-item status-filter" href="#" data-status="incadea-ventas">Ventas</a></li>
                                    <li><a class="dropdown-item status-filter" href="#" data-status="incadea-servicio">Servicio</a></li>
                                    <li><a class="dropdown-item status-filter" href="#" data-status="incadea-refacciones">Refacciones</a></li>
                                </ul>
                            </li>
                        </ul>
                    </div>
                    <div class="dropdown d-none">
                        <button class="btn btn-dark dropdown-toggle shadow-sm btn-anim" type="button" id="filterNombreDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person-fill me-1"></i> Nombre
                        </button>
                        <ul class="dropdown-menu shadow" aria-labelledby="filterNombreDropdown" style="max-height: 300px; overflow-y: auto;">
                            <li><a class="dropdown-item name-filter" href="#" data-name="todos">Ver Todos</a></li>
                            <li><hr class="dropdown-divider"></li>
                            @foreach (var nombre in (List<string>)ViewBag.Nombres) { <li><a class="dropdown-item name-filter" href="#" data-name="@nombre">@nombre</a></li> }
                        </ul>
                    </div>
                    <div class="dropdown d-none">
                        <button class="btn btn-dark dropdown-toggle shadow-sm btn-anim" type="button" id="filterContactoDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person-badge-fill me-1"></i> Contacto
                        </button>
                        <ul class="dropdown-menu shadow" aria-labelledby="filterContactoDropdown" style="max-height: 300px; overflow-y: auto;">
                            <li><a class="dropdown-item contact-filter" href="#" data-contact="todos">Ver Todos</a></li>
                            <li><hr class="dropdown-divider"></li>
                            @foreach (var contacto in (List<string>)ViewBag.Contactos) { <li><a class="dropdown-item contact-filter" href="#" data-contact="@contacto">@contacto</a></li> }
                        </ul>
                    </div>
                    <div class="dropdown d-none">
                        <button class="btn btn-dark dropdown-toggle shadow-sm btn-anim" type="button" id="filterNomenclaturaDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-tag-fill me-1"></i> Nomenclatura
                        </button>
                        <ul class="dropdown-menu shadow" aria-labelledby="filterNomenclaturaDropdown" style="max-height: 300px; overflow-y: auto;">
                            <li><a class="dropdown-item nomen-filter" href="#" data-nomen="todos">Ver Todas</a></li>
                            <li><hr class="dropdown-divider"></li>
                            @foreach (var nomen in (List<string>)ViewBag.Nomenclaturas) { <li><a class="dropdown-item nomen-filter" href="#" data-nomen="@nomen">@nomen</a></li> }
                        </ul>
                    </div>
                    <div class="dropdown d-none">
                        <button class="btn btn-dark dropdown-toggle shadow-sm btn-anim" type="button" id="filterEmpresaDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-building-fill me-1"></i> Filtrar por Empresa
                        </button>
                        <ul class="dropdown-menu shadow" aria-labelledby="filterEmpresaDropdown">
                            <li><a class="dropdown-item company-filter" href="#" data-company="todos">Ver Todas</a></li>
                            <li><hr class="dropdown-divider"></li>
                            @foreach (var empresa in (List<string>)ViewBag.Empresas)
                            {
                                <li><a class="dropdown-item company-filter" href="#" data-company="@empresa">@empresa</a></li>
                            }
                        </ul>
                    </div>
                    <div class="dropdown d-none">
                        <button class="btn btn-dark dropdown-toggle shadow-sm btn-anim" type="button" id="filterSucursalDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-geo-alt-fill me-1"></i> Filtrar por Sucursal
                        </button>
                        <ul class="dropdown-menu shadow" aria-labelledby="filterSucursalDropdown">
                            <li><a class="dropdown-item branch-filter" href="#" data-branch="todos">Ver Todas</a></li>
                            <li><hr class="dropdown-divider"></li>
                            @foreach (var sucursal in (List<string>)ViewBag.Sucursales)
                            {
                                <li><a class="dropdown-item branch-filter" href="#" data-branch="@sucursal">@sucursal</a></li>
                            }
                        </ul>
                    </div>
                    <div class="dropdown d-none">
                        <button class="btn btn-dark dropdown-toggle shadow-sm btn-anim" type="button" id="filterPuestoDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-briefcase-fill me-1"></i> Puesto
                        </button>
                        <ul class="dropdown-menu shadow" aria-labelledby="filterPuestoDropdown" style="max-height: 300px; overflow-y: auto;">
                            <li><a class="dropdown-item job-filter" href="#" data-job="todos">Ver Todos</a></li>
                            <li><hr class="dropdown-divider"></li>
                            @foreach (var puesto in (List<string>)ViewBag.Puestos) { <li><a class="dropdown-item job-filter" href="#" data-job="@puesto">@puesto</a></li> }
                        </ul>
                    </div>
                    <div class="dropdown d-none">
                        <button class="btn btn-dark dropdown-toggle shadow-sm btn-anim" type="button" id="filterDeptoDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-people-fill me-1"></i> Departamento
                        </button>
                        <ul class="dropdown-menu shadow" aria-labelledby="filterDeptoDropdown" style="max-height: 300px; overflow-y: auto;">
                            <li><a class="dropdown-item dept-filter" href="#" data-dept="todos">Ver Todos</a></li>
                            <li><hr class="dropdown-divider"></li>
                            @foreach (var depto in (List<string>)ViewBag.Departamentos) { <li><a class="dropdown-item dept-filter" href="#" data-dept="@depto">@depto</a></li> }
                        </ul>
                    </div>
                </div>

                <div id="historialMessageContainer" class="mt-3 mb-3">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @TempData["SuccessMessage"]<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @TempData["ErrorMessage"]<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                </div>

                <div class="card shadow border-0">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover table-striped align-middle text-nowrap bg-white">
                                <thead class="table-dark text-center align-middle">
                                <tr>
                                    <th scope="col">Folio</th>
                                    <th scope="col">Área</th>
                                    <th scope="col">Nombre</th>
                                    <th scope="col">Contacto</th>
                                    <th scope="col">Nomenclatura</th>
                                    <th scope="col">Empresa</th>
                                    <th scope="col">Sucursal</th>
                                    <th scope="col">Puesto</th>
                                    <th scope="col">Departamento</th>
                                    <th scope="col">Teléfono</th>
                                    <th scope="col">Extensión</th>
                                    <th scope="col">Celular</th>
                                    <th scope="col">Descripción</th>
                                    <th scope="col">Evidencia</th>
                                    <th scope="col">Estatus</th>
                                    <th scope="col">Atendido por</th>
                                    <th scope="col">Comentarios</th>
                                </tr>
                            </thead>
                            <tbody id="table-services" class="text-center">
                                @foreach (var item in Model)
                                {
                                    var rowClass = item.Estatus switch
                                    {
                                        "nuevo" => "table-primary",
                                        "proceso" => "table-secondary",
                                        "cerrado" => "table-success",
                                        _ => ""
                                    };
                                    <tr data-id-orden="@item.Id" data-tipo="@(item.TipoSolicitud?.ToLower() ?? "")" data-area="@(item.Area?.ToLower() ?? "")" data-origen="@item.OrigenTabla" class="@rowClass">
                                        <td>@item.Id</td>
                                        <td style="cursor: pointer;" 
                                            class="fw-bold text-primary"
                                            onclick="showTicketDetails(@item.Id, '@item.OrigenTabla')"
                                            title="Haz clic para ver todos los detalles">
                                            @item.TipoSolicitud @(string.IsNullOrEmpty(item.Area) ? "" : "- " + item.Area)
                                        </td>
                                        <td>@item.Nombre</td>
                                        <td>@item.Contacto</td>
                                        <td>@item.Nomenclatura</td>
                                        <td>@item.Empresa</td>
                                        <td>@item.Sucursal</td>
                                        <td>@item.Puesto</td>
                                        <td>@item.Departamento</td>
                                        <td>@item.Telefono</td>
                                        <td>@(string.IsNullOrEmpty(item.Extension) ? "" : "" + item.Extension)</td>
                                        <td>@item.Celular</td>
                                        <td class="text-wrap text-start" style="min-width: 300px; max-width: 500px;">@item.Descripcion</td>
                                        <td class="text-center">
                                            @if (!string.IsNullOrEmpty(item.Evidencia))
                                            {
                                                <div class="d-flex flex-wrap justify-content-center gap-1" style="min-width: 100px;">
                                                    @foreach (var foto in item.Evidencia!.Split(','))
                                                    {
                                                        var ext = (System.IO.Path.GetExtension(foto) ?? "").ToLower();
                                                        if (ext == ".jpg" || ext == ".jpeg" || ext == ".png" || ext == ".gif")
                                                        {
                                                            <img src="~/uploads/@foto" alt="Evidencia" 
                                                                 style="width: 45px; height: 45px; object-fit: cover;" 
                                                                 class="rounded shadow-sm img-clickable" 
                                                                 onclick="openViewer('@Url.Content("~/uploads/" + foto)', 'image')">
                                                        }
                                                        else
                                                        {
                                                            <i class="bi @(ext == ".pdf" ? "bi-file-earmark-pdf text-danger" : 
                                                                          ext.Contains("doc") ? "bi-file-earmark-word text-primary" :
                                                                          ext.Contains("xls") ? "bi-file-earmark-excel text-success" :
                                                                          ext.Contains("ppt") ? "bi-file-earmark-ppt text-warning" : "bi-file-earmark") file-icon"
                                                               onclick="openViewer('@Url.Content("~/uploads/" + foto)', 'file')"></i>
                                                        }
                                                    }
                                                </div>
                                            }
                                        </td>
                                        <td>
                                            <select class="form-select form-select-sm" name="estatus" title="Seleccionar estatus del servicio">
                                                <option value="" selected disabled>Seleccione una opción</option>
                                                <option value="nuevo" selected="@(item.Estatus == "nuevo")">Nuevo</option>
                                                <option value="proceso" selected="@(item.Estatus == "proceso")">En proceso</option>
                                                <option value="cerrado" selected="@(item.Estatus == "cerrado")">Cerrado</option>
                                            </select>
                                        </td>
                                        <td>
                                            <select class="form-select form-select-sm" name="asignado_a" title="Asignar técnico" @(ViewBag.Usuario?.ToLower() != "jefe0017" ? "disabled" : "")>
                                                <option value="">Sin asignar</option>
                                                <option value="jefe0017" selected="@(item.AsignadoA == "jefe0017")">Jefe 0017</option>
                                                <option value="asistente0013" selected="@(item.AsignadoA == "asistente0013")">Asistente 0013</option>
                                                <option value="asistente0014" selected="@(item.AsignadoA == "asistente0014")">Asistente 0014</option>
                                            </select>
                                        </td>
                                        <td>
                                            <div class="form-floating">
                                                <textarea class="form-control" placeholder="Escriba un comentario"
                                                          id="comentario-@item.Id-@item.OrigenTabla"
                                                          name="comentarios"
                                                          style="height: 60px; min-width: 200px;">@item.Comentarios</textarea>
                                                <label for="comentario-@item.Id-@item.OrigenTabla">Comentario</label>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

    <!-- Modal para ver imagen en grande -->
    <div class="modal fade" id="imageModal" tabindex="-1" aria-labelledby="imageModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content bg-dark border-secondary">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title text-white" id="imageModalLabel">Evidencia del Servicio</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-center p-0">
                    <!-- Visores Locales -->
                    <img src="" id="fullImage" class="img-fluid rounded-bottom w-100 d-none" alt="Vista Previa">
                    <embed src="" id="fileViewer" class="w-100 d-none" type="application/pdf" style="height: 75vh;">
                    <!-- Contenedor para renderizado local de Office -->
                    <div id="localDocViewer" class="w-100 d-none"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal para Detalles de Ticket -->
    <div class="modal fade" id="ticketDetailModal" tabindex="-1" aria-labelledby="ticketDetailModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content bg-dark text-white border-primary shadow-lg">
                <div class="modal-header border-primary">
                    <h5 class="modal-title" id="ticketDetailModalLabel">Detalles del Ticket</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" id="ticketDetailBody">
                    <!-- El contenido se inyectará aquí -->
                </div>
                <div class="modal-footer border-primary">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal para Selección de Filtros Secundarios -->
    <div class="modal fade" id="filterSelectionModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-dark text-white border-primary shadow-lg">
                <div class="modal-header border-primary">
                    <h5 class="modal-title fw-bold text-primary"><i class="bi bi-funnel-fill me-2"></i>Refinar Búsqueda</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body py-4">
                    <div id="filterCategoryContainer" class="d-grid gap-2">
                        <!-- Botones de categorías inyectados por JS -->
                    </div>
                    <div id="filterValueContainer" class="d-none">
                        <button class="btn btn-sm btn-link text-info text-decoration-none mb-3 p-0" onclick="backToCategories()">
                            <i class="bi bi-arrow-left"></i> Volver a categorías
                        </button>
                        <h6 class="mb-3 text-muted" id="filterValueTitle"></h6>
                        <div id="filterValuesList" class="list-group list-group-flush overflow-auto shadow-sm rounded" style="max-height: 350px;">
                            <!-- Valores inyectados por JS -->
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-primary justify-content-between">
                    <button type="button" class="btn btn-outline-danger btn-sm" onclick="resetSecondaryFilters()">Limpiar Filtros</button>
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Librerías para visualización local (Descargarlas para uso 100% offline) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/mammoth/1.6.0/mammoth.browser.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>

        async function openViewer(url, type) {
            const img = document.getElementById('fullImage');
            const embed = document.getElementById('fileViewer');
            const localViewer = document.getElementById('localDocViewer');
            const modalElement = document.getElementById('imageModal');
            const modal = bootstrap.Modal.getOrCreateInstance(modalElement);

            img.classList.add('d-none');
            embed.classList.add('d-none');
            localViewer.classList.add('d-none');
            localViewer.innerHTML = "Cargando documento...";

            if (type === 'image') {
                img.src = url;
                img.classList.remove('d-none');
                modal.show();
            } else {
                const ext = url.split('.').pop().toLowerCase();
                if (ext === 'pdf') {
                    embed.src = url;
                    embed.classList.remove('d-none');
                    modal.show();
                } else {
                    // Procesamiento Local para Word y Excel
                    modal.show();
                    localViewer.classList.remove('d-none');
                    try {
                        const response = await fetch(url);
                        const arrayBuffer = await response.arrayBuffer();

                        if (ext === 'docx') {
                            const result = await mammoth.convertToHtml({ arrayBuffer: arrayBuffer });
                            localViewer.innerHTML = result.value;
                        } else if (ext === 'xlsx' || ext === 'xls') {
                            const workbook = XLSX.read(new Uint8Array(arrayBuffer), { type: 'array' });
                            const firstSheetName = workbook.SheetNames[0];
                            const worksheet = workbook.Sheets[firstSheetName];
                            localViewer.innerHTML = `<div class="table-responsive">${XLSX.utils.sheet_to_html(worksheet)}</div>`;
                        } else if (ext === 'pptx') {
                            localViewer.innerHTML = `
                                <div class="p-5 text-center">
                                    <i class="bi bi-file-earmark-ppt text-danger" style="font-size: 4rem;"></i>
                                    <p class="mt-3">La visualización local de PowerPoint es limitada.</p>
                                    <a href="${url}" class="btn btn-danger" download>Descargar para ver</a>
                                </div>`;
                        }
                    } catch (error) {
                        localViewer.innerHTML = "Error al cargar el documento localmente: " + error.message;
                    }
                }
            }
        }

        async function showTicketDetails(id, origen) {
            const modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('ticketDetailModal'));
            const modalBody = document.getElementById('ticketDetailBody');
            const modalTitle = document.getElementById('ticketDetailModalLabel');

            modalTitle.textContent = `Detalles del Ticket #${id}`;
            modalBody.innerHTML = '<div class="text-center py-5"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Cargando...</span></div></div>';
            modal.show();

            try {
                const response = await fetch(`@Url.Action("GetTicketDetails", "HistorialSoftware")?id=${id}&origen=${origen}`);
                if (!response.ok) throw new Error('No se pudo cargar la información del ticket.');
                
                const { ticket, history } = await response.json();

                let detailsHtml = '<div class="row g-3">';

                const fields = [
                    { label: 'Folio', value: ticket.id },
                    { label: 'Tipo Solicitud', value: `${ticket.tipoSolicitud} ${ticket.area ? '- ' + ticket.area : ''}` },
                    { label: 'Nombre', value: ticket.nombre },
                    { label: 'Contacto', value: ticket.contacto },
                    { label: 'Nomenclatura', value: ticket.nomenclatura },
                    { label: 'Empresa', value: ticket.empresa },
                    { label: 'Sucursal', value: ticket.sucursal },
                    { label: 'Puesto', value: ticket.puesto },
                    { label: 'Departamento', value: ticket.departamento },
                    { label: 'Teléfono', value: ticket.telefono },
