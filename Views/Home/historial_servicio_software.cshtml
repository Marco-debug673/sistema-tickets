        async function updateTableStatus() {
            try {
                const response = await fetch('@Url.Action("GetHistorialStatusSoftware", "HistorialSoftware")');
                if (!response.ok) return;

                const updates = await response.json();
                updates.forEach(update => {
                    const row = document.querySelector(`tr[data-id-orden="${update.idOrden}"][data-origen="${update.origenTabla}"]`);
                    if (row) {
                        // Actualizar Estatus
                        const estatusSelect = row.querySelector('select[name="estatus"]');
                        if (estatusSelect && estatusSelect.value !== update.estatus && document.activeElement !== estatusSelect) {
                            estatusSelect.value = update.estatus;
                            updateRowColor(estatusSelect);
                        }

                        // Actualizar Asignación
                        const asignadoSelect = row.querySelector('select[name="asignado_a"]');
                        if (asignadoSelect && asignadoSelect.value !== update.asignadoA && document.activeElement !== asignadoSelect) {
                            asignadoSelect.value = update.asignadoA || "";
                        }
                    }
                });
            } catch (error) {
                console.error("Error al actualizar estatus automáticamente:", error);
            }
        }

        // Configura el intervalo para verificar actualizaciones cada 60 segundos
        document.addEventListener('DOMContentLoaded', () => {
            // Ocultar columna vacía por defecto al iniciar
            updateColumnVisibility('todos');

            document.querySelectorAll('select[name="estatus"]').forEach(select => {
                select.addEventListener('change', function () { updateRowColor(this); });
            });

            // Iniciar la actualización en tiempo real
            setInterval(updateTableStatus, 60000);
        });
    </script>
</body>
</html> 