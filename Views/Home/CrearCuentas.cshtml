@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Crear Nuevas Cuentas</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        .btn-anim:hover {
            transform: scale(1.03);
            transition: transform 0.3s ease;
        }
        body {
            background-color: #f0f2f5;
        }
        .text-custom {
            color: #1e539f !important;
        }
        .shadow-thick {
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15) !important;
        }
        /* Corrección de bordes redondeados al usar form-floating dentro de input-group */
        .input-group > .form-floating:not(:last-child) > .form-control {
            border-top-right-radius: 0;
            border-bottom-right-radius: 0;
        }
    </style>
</head>
<body>
    <!-- Botón de Cerrar Sesión -->
    <div class="position-absolute top-0 end-0 p-3">
        <a href="@Url.Action("Logout", "Account")" class="btn btn-danger btn-anim shadow-sm" title="Cerrar Sesión">
            <i class="bi bi-box-arrow-right fs-4"></i>
        </a>
    </div>
    <div class="container min-vh-100 d-flex justify-content-center align-items-center">
        <div class="col-12 col-md-8 col-lg-6 col-xl-5">
            <form id="createAccountForm" method="post" action="@Url.Action("Crear", "CrearCuentas")" class="bg-white p-5 rounded shadow-thick">
                <h2 class="text-custom mb-4 text-center fw-bold">
                    <i class="bi bi-person-plus-fill me-2"></i>Nuevos Usuarios
                </h2>

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger text-center py-2 mb-3">@TempData["ErrorMessage"]</div>
                }

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success text-center py-2 mb-3">@TempData["SuccessMessage"]</div>
                }

                <div class="form-floating mb-3">
                    <input type="text" class="form-control" id="username" name="username" placeholder="Usuario" autocomplete="off">
                    <label for="username">
                        <i class="bi bi-person me-1"></i>Usuario
                    </label>
                </div>
                <div class="input-group mb-4">
                    <div class="form-floating">
                        <input type="text" class="form-control" id="password" name="password" placeholder="Contraseña generada" readonly>
                        <label for="password"><i class="bi bi-lock me-1"></i>Contraseña</label>
                    </div>
                    <button class="btn btn-outline-secondary d-flex align-items-center justify-content-center" type="button" id="generatePasswordBtn" title="Generar y copiar contraseña">
                        <i class="bi bi-shuffle"></i>
                    </button>
                </div>
                <div class="d-grid mb-3">
                    <button class="btn btn-primary btn-anim fw-bold" type="submit" id="createBtn">
                        <i class="bi bi-check-circle me-1"></i> Crear Cuenta
                    </button>
                </div>
            </form>
        </div>
    </div>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('createAccountForm');
            const passwordInput = document.getElementById('password');
            const generateBtn = document.getElementById('generatePasswordBtn');

            // Generador de contraseñas usando API criptográfica segura
            function generateSecurePassword(length = 10) {
                const charset = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@@#$";
                const array = new Uint32Array(length);
                window.crypto.getRandomValues(array);
                let password = "";
                for (let i = 0; i < length; i++) {
                    password += charset[array[i] % charset.length];
                }
                return password;
            }

            generateBtn.addEventListener('click', function () {
                const password = generateSecurePassword(10);
                passwordInput.removeAttribute('readonly'); // Habilitar temporalmente para asignar valor
                passwordInput.value = password;

                // Intentar copiar al portapapeles
                if (navigator.clipboard && window.isSecureContext) {
                    navigator.clipboard.writeText(password).then(() => {
                        showCopyFeedback();
                    }).catch(() => {
                        showCopyFeedback(); // Fallback de interfaz
                    });
                } else {
                    showCopyFeedback();
                }
                passwordInput.setAttribute('readonly', true); // Volver a deshabilitar
            });

            function showCopyFeedback() {
                const originalContent = generateBtn.innerHTML;
                generateBtn.innerHTML = '<i class="bi bi-check-lg text-success fs-5"></i>';
                setTimeout(() => {
                    generateBtn.innerHTML = originalContent;
                }, 1500);
            }

            // Validar en el evento Submit del formulario (cubre Click y tecla Enter)
            form.addEventListener('submit', function (e) {
                if (!form.checkValidity() || passwordInput.value.trim() === '') {
                    e.preventDefault();
                    alert('Por favor, genera una contraseña antes de crear la cuenta.');
                    passwordInput.focus();
                }
            });
        });
    </script>
</body>
</html>